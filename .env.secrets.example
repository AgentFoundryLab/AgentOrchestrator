# 1Password Secret References
# Global defaults for dotfiles-level tooling.
# This file is committed as documentation only; keep your real `.env.secrets` untracked.

# GitHub CLI/API token
# Fine-grained token should include access to repos you automate against
# GITHUB_TOKEN=op://Vault/GitHub/GITHUB_PERSONAL_ACCESS_TOKEN

# GitHub MCP / bootstrap token
# Keep this aligned with GITHUB_TOKEN unless a repo needs a narrower local override.
# GITHUB_PERSONAL_ACCESS_TOKEN=op://Vault/GitHub/GITHUB_PERSONAL_ACCESS_TOKEN

# Context7
# CONTEXT7_API_KEY=op://Vault/Context7/CONTEXT7_API_KEY

# Parallel.ai
# PARALLEL_API_KEY=op://Vault/Parallel/PARALLEL_API_KEY

# Sourcegraph
# SOURCEGRAPH_ACCESS_TOKEN=op://Vault/Sourcegraph/SOURCEGRAPH_ACCESS_TOKEN
